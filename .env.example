# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/dari_belle

# JWT Authentication
JWT_ACCESS_SECRET=daribelle_super_secret_access_key_2026_jwt_token
JWT_REFRESH_SECRET=daribelle_super_secret_refresh_key_2026_refresh_jwt
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Cloudinary (Optionnel pour stockage cloud photos)
CLOUDINARY_CLOUD_NAME=demo
CLOUDINARY_API_KEY=demo
CLOUDINARY_API_SECRET=demo

# Frontend Client Configuration
VITE_API_URL=http://localhost:5000/api/v1